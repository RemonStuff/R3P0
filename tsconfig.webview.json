{
  // The webview runs in a browser: DOM types, and no global node or vscode types.
  // An explicit `import "vscode"` would still resolve; ESLint is what bans it.
  // It may import src/core, so core must also compile here.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": []
  },
  "include": ["src/webview", "src/core", "test/webview"],
  "exclude": ["node_modules", "dist"]
}
