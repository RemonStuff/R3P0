{
  "name": "r3p0",
  "displayName": "R3P0",
  "description": "One chat per repo, with every request metered through Q0T4's weekly budgets.",
  "version": "0.0.1",
  "publisher": "RemonStuff",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/RemonStuff/R3P0.git"
  },
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {},
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.webview.json && tsc --noEmit -p tsconfig.integration.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "coverage": "vitest run --coverage",
    "test:integration": "npm run build && node test/fixtures/build.mjs && node test/fixtures/workspaces/create.mjs && tsc -p tsconfig.integration.json && vscode-test",
    "vscode:prepublish": "node esbuild.mjs --production",
    "package": "vsce package --no-dependencies --skip-license"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/vscode": "1.104.0",
    "@vitest/coverage-v8": "^5.0.5",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.3",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
